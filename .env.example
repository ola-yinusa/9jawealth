# Resend SMTP (server-side only)
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=your-resend-api-key
RESEND_MAIL_FROM=9jawealth <assessment@9jawealth.com>
RESEND_REPLY_TO=hello@9jawealth.com
RESEND_NOTIFY_TO=hello@9jawealth.com

# Lark Base lead capture (server-side only)
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_BASE_TOKEN=your-lark-base-token
LARK_TABLE_ID=your-lark-table-id
# Optional: defaults to https://open.larksuite.com
# LARK_API_BASE_URL=https://open.larksuite.com

# Optional: comma-separated origins allowed to call /api/send-report.
# Defaults to https://www.9jawealth.com,https://9jawealth.com when unset.
# ALLOWED_ORIGINS=https://www.9jawealth.com,https://9jawealth.com

# Vercel Blob (redacted submission backup storage)
# Auto-created when you link a Blob store in Vercel dashboard → Storage tab
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxx
# Set to "false" to disable Blob backups entirely (email delivery still works).
# BLOB_ENABLED=true
